# Use DATABASE_URL or the POSTGRES_URL injected by the Supabase/Vercel integration.
# Keep credential values in private environment settings, never in Git.
DATABASE_URL=
POSTGRES_URL=
# Session pooler/direct connection for administrative migrations.
POSTGRES_URL_NON_POOLING=
# Optional explicit migration override, for the same database as runtime.
DATABASE_MIGRATION_URL=
# Optional trusted CA override (PEM). Hosted Supabase production roots are bundled.
DATABASE_SSL_CA=
# Google sign-in requires all three Auth.js settings as well as the database.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local callback: http://localhost:3000/api/auth/callback/google
# Production callback: https://YOUR_DOMAIN/api/auth/callback/google
